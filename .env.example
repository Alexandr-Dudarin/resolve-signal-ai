NODE_ENV="development"
DATABASE_URL="postgresql://resolve_signal:resolve_signal@localhost:5434/resolve_signal?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
AI_PROVIDER="mock"
# Empty uses the Vite /api proxy locally and the Vercel /api rewrite after deployment.
VITE_API_URL=""
AI_USAGE_LIMITS_ENABLED="true"
AI_LIMIT_PER_IP_MINUTE=5
AI_LIMIT_PER_IP_DAY=20
AI_LIMIT_GLOBAL_DAY=100
TRUST_PROXY_HOPS=0

# Required only when AI_PROVIDER="openai".
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="your-openai-model"

# Local gate is opt-in. Production defaults to enabled and refuses false.
DEMO_ACCESS_ENABLED="false"
DEMO_SESSION_TTL_SECONDS=43200
DEMO_LOGIN_PER_IP=5
DEMO_LOGIN_GLOBAL=30
DEMO_WRITE_PER_IP_MINUTE=30
DEMO_WRITE_GLOBAL_MINUTE=60
DEMO_CREATE_GLOBAL_DAY=100
# Generate independently with node:crypto, never commit real values.
# DEMO_ACCESS_CODE: randomBytes(16).toString("base64url"), at least 22 chars.
# DEMO_SESSION_SECRET: randomBytes(32).toString("base64url"), at least 43 chars.
# Both: base64url only, up to 128 chars, at least 12 distinct chars, must differ.
# DEMO_ACCESS_CODE=
# DEMO_SESSION_SECRET=

# Vercel configuration ONLY: actual HTTPS Render origin, no trailing slash.
# RENDER_API_ORIGIN=

# Manual dedicated public-demo DB commands ONLY; never fallback to DATABASE_URL.
# DIRECT_URL=
# PUBLIC_DEMO_DB_HOST=
# PUBLIC_DEMO_DB_NAME=
# PUBLIC_DEMO_CONFIRM=init-public-demo OR migrate-public-demo
# PUBLIC_DEMO_ALLOW_LOCAL=true (only for isolated local acceptance, never production)
